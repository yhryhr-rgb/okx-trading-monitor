# Copy to a server-side .env file. Never commit the real file.
# Do not select these URLs from physical location or app language.
# Confirm the account's contracting/service entity in OKX first.
# Standard/global: https://openapi.okx.com ; wss://ws.okx.com/ws/v5/private
# US/AU (registered via app.okx.com): https://us.okx.com ; wss://wsus.okx.com/ws/v5/private
# EEA (registered via my.okx.com): https://eea.okx.com ; wss://wseea.okx.com/ws/v5/private
# Keep blank until the account's permitted service entity is confirmed.
OKX_BASE_URL=
OKX_PRIVATE_WS_URL=

# Leave all three blank for offline mode. Use an API key with Read permission only.
# Never put these values in GitHub, screenshots, or chat.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Local service only. Do not bind to 0.0.0.0 without a reviewed auth layer.
APP_HOST=127.0.0.1
APP_PORT=8765
DATABASE_PATH=/opt/okx-monitor/data/monitor.db
LOG_LEVEL=INFO
