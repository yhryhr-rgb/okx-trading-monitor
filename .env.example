# Copy to a server-side environment file. Never commit the real file.
# Leave blank until the account's permitted OKX service region/API host is verified.
OKX_BASE_URL=

# Leave blank for offline mode. Never put these values in GitHub or chat.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Local service only. Do not bind to 0.0.0.0 without a reviewed auth layer.
APP_HOST=127.0.0.1
APP_PORT=8765
DATABASE_PATH=/opt/okx-monitor/data/monitor.db
LOG_LEVEL=INFO
