[Unit]
Description=DMIT Los Angeles VPS stock email alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=dmit-stock
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -I -B /opt/dmit-stock/stock.py
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
